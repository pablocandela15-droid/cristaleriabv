# Copia este archivo como .env.local y rellena los valores.
# Sin las variables de Supabase la web usa los valores del código (src/content/*
# y src/lib/pricing/*): contacto y reservas por WhatsApp y asistente con las FAQ.

# URL pública de la web (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase del panel de administración (repo admin-cristaleriabv), Settings → API Keys.
# La web solo lee el contenido editable (web_contenido, web_tarifas, web_albumes,
# web_fotos) y envía las solicitudes de presupuesto. Nunca pongas aquí la secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Formularios antiguos de la web (edge functions contact, book-appointment y chat de
# la carpeta supabase/ de este repo). Déjalo vacío: no existen en el proyecto del panel.
# Con 1, el contacto, la reserva y el asistente usan esas funciones en vez de WhatsApp.
NEXT_PUBLIC_FORMULARIOS_SUPABASE=
